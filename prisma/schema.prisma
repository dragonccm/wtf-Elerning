generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum NodeType {
  VIDEO
  FLASHCARD
  QUIZ
  ESSAY
  MILESTONE
}

enum NodeStatus {
  LOCKED
  CURRENT
  COMPLETED
}

enum QuestionType {
  SINGLE
  MULTI
  MATCH
  FILL
  ORDER
  LISTEN
  ESSAY_PARAGRAPH
  ESSAY_TRANSLATE
  ESSAY_QA
  ESSAY_TOPIC
}

enum ErrorType {
  VOCAB
  GRAMMAR
  STRUCTURE
  PINYIN
  EXPRESSION
}

enum CourseCategory {
  HSK
  COMMUNICATION
  EXAM
}

enum PublishStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ClassroomStatus {
  DRAFT
  OPEN
  ACTIVE
  ENDED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  SENT
  SKIPPED_DEV
  FAILED
  ACCEPTED
  EXPIRED
}

enum AssignmentStatus {
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STUDENT)
  avatarUrl    String?
  googleId     String?  @unique
  googleAccessToken  String?
  googleRefreshToken String?
  googleScope        String?
  bio          String?
  isActive     Boolean  @default(true)
  disabledAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taughtCourses   Course[]          @relation("CourseTeacher")
  enrollments     Enrollment[]
  submissions     Submission[]
  essayFeedbacks  EssayFeedback[]   @relation("TeacherFeedback")
  progressEvents  ProgressEvent[]
  flashcardMarks  FlashcardMark[]
  studySessions   StudySession[]
  streak          UserStreak?
  dailyGoals      DailyGoal[]
  xpEvents        XpEvent[]
  createdCourses  Course[]          @relation("CourseCreator")
  reviewedCourses Course[]          @relation("CourseReviewer")
  taughtClasses   Classroom[]       @relation("ClassroomTeacher")
  classMemberships ClassroomMember[]
  invitationsSent ClassInvitation[] @relation("InvitationSender")
  invitations     ClassInvitation[] @relation("InvitationRecipient")
  notifications   Notification[]
  auditLogs        AuditLog[]        @relation("AuditActor")
  announcements    Announcement[]  @relation("AnnouncementAuthor")
  assignmentsCreated Assignment[]    @relation("AssignmentCreator")
  materialsAdded   ClassMaterial[]   @relation("MaterialAddedBy")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  level       String   @default("HSK1")
  coverColor  String   @default("#1FA97A")
  published   Boolean  @default(true)
  teacherId   String?
  category    CourseCategory @default(HSK)
  status      PublishStatus  @default(DRAFT)
  creatorId   String?
  reviewerId  String?
  reviewNote  String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User?        @relation("CourseTeacher", fields: [teacherId], references: [id])
  units       Unit[]
  enrollments Enrollment[]
  creator     User?        @relation("CourseCreator", fields: [creatorId], references: [id])
  reviewer    User?        @relation("CourseReviewer", fields: [reviewerId], references: [id])
  classrooms  Classroom[]
}

model Classroom {
  id              String          @id @default(cuid())
  courseId        String
  teacherId       String
  name            String
  code            String          @unique
  passwordHash    String
  passwordVersion Int             @default(1)
  status          ClassroomStatus @default(DRAFT)
  startsAt        DateTime?
  endsAt          DateTime?
  failedAttempts  Int             @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     User               @relation("ClassroomTeacher", fields: [teacherId], references: [id])
  members     ClassroomMember[]
  invitations ClassInvitation[]
  announcements Announcement[]
  assignments Assignment[]
  sessions    ClassSession[]
  materials   ClassMaterial[]

  @@index([teacherId, status])
  @@index([courseId])
}

model ClassroomMember {
  id          String   @id @default(cuid())
  classroomId String
  userId      String
  joinedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId])
}

model ClassInvitation {
  id          String           @id @default(cuid())
  classroomId String
  senderId    String
  recipientId String?
  email       String
  status      InvitationStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  acceptedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  sender    User      @relation("InvitationSender", fields: [senderId], references: [id])
  recipient User?     @relation("InvitationRecipient", fields: [recipientId], references: [id])

  @@index([email, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  detailJson String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  ownerId      String
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime @default(now())

  classMaterials ClassMaterial[]

  @@index([ownerId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Unit {
  id          String @id @default(cuid())
  courseId    String
  title       String
  objective   String?
  orderIndex  Int
  status      PublishStatus @default(DRAFT)

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  nodes  LessonNode[]
}

model LessonNode {
  id         String   @id @default(cuid())
  unitId     String
  title      String
  type       NodeType
  orderIndex Int
  xpReward   Int      @default(10)
  status     PublishStatus @default(DRAFT)

  unit          Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  video         LessonVideo?
  flashcardDeck FlashcardDeck?
  assessment    Assessment?
  progress      ProgressEvent[]
  assignmentTargets AssignmentNode[]
}

model LessonVideo {
  id          String  @id @default(cuid())
  nodeId      String  @unique
  videoUrl    String
  pdfUrl      String?
  durationSec Int     @default(300)
  summary     String?

  chapters VideoChapter[]

  node LessonNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model VideoChapter {
  id         String   @id @default(cuid())
  videoId    String
  title      String
  startSec   Int
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  video LessonVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model FlashcardDeck {
  id          String @id @default(cuid())
  nodeId      String @unique
  title       String
  topic       String?
  level       String?

  node  LessonNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  cards Flashcard[]
}

model Flashcard {
  id        String  @id @default(cuid())
  deckId    String
  hanzi     String
  pinyin    String
  meaningVi String
  example   String?
  imageUrl  String?

  deck  FlashcardDeck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  marks FlashcardMark[]
}

model FlashcardMark {
  id             String    @id @default(cuid())
  userId         String
  flashcardId    String
  known          Boolean   @default(false)
  stage          Int       @default(0)
  dueAt          DateTime?
  lastReviewedAt DateTime?
  updatedAt      DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId, dueAt])
}

model Assessment {
  id          String @id @default(cuid())
  nodeId      String @unique
  title       String
  description String?
  passScore   Int    @default(70)

  node      LessonNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id             String       @id @default(cuid())
  assessmentId   String
  type           QuestionType
  prompt         String
  promptAudioUrl String?
  optionsJson    String?
  answerJson     String
  orderIndex     Int
  points         Int          @default(1)
  rubricJson     String?      // essay rubric: [{name, maxPoints}]

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    Answer[]
}

model Submission {
  id           String   @id @default(cuid())
  userId       String
  assessmentId String
  score        Float?
  maxScore     Float?
  autoGraded   Boolean  @default(false)
  status       String   @default("SUBMITTED")
  submittedAt  DateTime @default(now())
  gradedAt     DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]
  feedback EssayFeedback?

  @@index([assessmentId])
}

model Answer {
  id           String  @id @default(cuid())
  submissionId String
  questionId   String
  responseJson String
  isCorrect    Boolean?
  pointsEarned Float?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model EssayFeedback {
  id         String   @id @default(cuid())
  submissionId String  @unique
  teacherId    String
  score        Float
  comment      String
  rubricJson   String? // per-criterion scores: [{name, maxPoints, points}]
  createdAt    DateTime @default(now())

  submission Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacher    User        @relation("TeacherFeedback", fields: [teacherId], references: [id])
  errorMarks ErrorMark[]
}

model ErrorMark {
  id         String    @id @default(cuid())
  feedbackId String
  type       ErrorType
  excerpt    String
  suggestion String
  startIndex Int?
  endIndex   Int?

  feedback EssayFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model ProgressEvent {
  id          String   @id @default(cuid())
  userId      String
  nodeId      String
  completed   Boolean  @default(false)
  score       Float?
  timeSpentSec Int     @default(0)
  completedAt DateTime?
  lastPositionSec Int?
  lastWatchedAt DateTime?
  updatedAt   DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  node LessonNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
}

model StudySession {
  id           String   @id @default(cuid())
  userId       String
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  durationSec  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStreak {
  id             String  @id @default(cuid())
  userId         String  @unique
  currentStreak  Int     @default(0)
  longestStreak  Int     @default(0)
  lastActiveDate String?
  totalXp        Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyGoal {
  id        String  @id @default(cuid())
  userId    String
  date      String
  targetXp  Int     @default(20)
  earnedXp  Int     @default(0)
  completed Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(cuid())
  classroomId String
  authorId    String
  title       String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  author    User      @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([classroomId, createdAt])
}

model Assignment {
  id          String             @id @default(cuid())
  classroomId String
  createdBy   String
  title       String
  description String?
  dueAt       DateTime
  status      AssignmentStatus   @default(PUBLISHED)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  publishedAt DateTime?
  closedAt    DateTime?

  classroom Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  creator   User             @relation("AssignmentCreator", fields: [createdBy], references: [id])
  nodes     AssignmentNode[]

  @@index([classroomId, status])
  @@index([dueAt])
}

model AssignmentNode {
  id           String @id @default(cuid())
  assignmentId String
  nodeId       String
  orderIndex   Int

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  node       LessonNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, nodeId])
}

model ClassSession {
  id          String        @id @default(cuid())
  classroomId String
  title       String
  startsAt    DateTime
  endsAt      DateTime
  status      SessionStatus @default(SCHEDULED)
  roomKey     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, startsAt])
}

model ClassMaterial {
  id           String   @id @default(cuid())
  classroomId  String
  mediaAssetId String
  title        String
  addedById    String
  createdAt    DateTime @default(now())

  classroom  Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])
  addedBy    User       @relation("MaterialAddedBy", fields: [addedById], references: [id])

  @@index([classroomId])
}
